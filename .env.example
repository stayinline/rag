# Application
APP_NAME="RAG Knowledge Base"
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-random-string
API_PREFIX=/api/v1

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rag_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Weaviate
WEAVIATE_URL=http://localhost:8080
WEAVIATE_GRPC_PORT=50051

# Qwen / DashScope
DASHSCOPE_API_KEY=your-dashscope-api-key
LLM_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3
RERANKER_TYPE=bm25
RERANK_MODEL_NAME=gte-rerank-v2
LLM_CONTEXT_WINDOW_TOKENS=8192
LLM_MAX_OUTPUT_TOKENS=2048

# File Storage
STORAGE_PATH=./data/files

# JWT
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# RAG
RAG_MAX_CHUNKS=8
RAG_CHUNK_OVERLAP=80
RAG_CHUNK_SIZE=600
RAG_TOP_K=20
RAG_CONTEXT_SAFETY_MARGIN_TOKENS=512
RAG_PARENT_CONTEXT_WINDOW=1
CONTEXTUAL_COMPRESSION=true
CONTEXTUAL_COMPRESSION_MAX_SENTENCES=3
LLM_QUERY_REWRITE=false
LLM_QUERY_REWRITE_MODEL=
CITATION_MIN_SCORE=0.0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
